{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-factory/toolkit-feature-map/changes.schema.json",
  "title": "PR file changes",
  "description": "The file changes of one PR or diff, as check-pr.mjs reads them (from gh api pulls/<N>/files, git diff --name-status, or --changes <file>).",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "status",
      "path"
    ],
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": [
          "added",
          "modified",
          "removed",
          "renamed"
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Path after the change (the old path for removed)"
      },
      "previousPath": {
        "type": "string",
        "minLength": 1,
        "description": "Old path; only for renamed"
      }
    }
  }
}
