{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "build-compare-grid spec",
  "type": "object",
  "required": [
    "out",
    "columns",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "out": {
      "type": "string",
      "minLength": 1,
      "description": "PNG to write"
    },
    "panelWidth": {
      "type": "integer",
      "minimum": 100,
      "description": "Each panel is resized to this width (default 480)"
    },
    "noReference": {
      "type": "string",
      "minLength": 1,
      "description": "Why the grid has no Prototype, Figma or Reference column (e.g. 'the prototype has no chat scrollbar'); drawn under the grid. Required when no column header names one"
    },
    "minStdDev": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "A panel whose crop has a lower standard deviation (0-1) is refused as blank (default 0.02)"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "panels"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Screenshot path"
                },
                "crop": {
                  "type": "string",
                  "pattern": "^[0-9]+x[0-9]+\\+[0-9]+\\+[0-9]+$",
                  "description": "magick geometry WxH+X+Y"
                },
                "guideX": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "x in the crop (before resize) for a thin vertical guide line"
                },
                "caption": {
                  "type": "string",
                  "description": "Measured note under the panel, e.g. 'name 20px, price 24px'"
                },
                "probe": {
                  "type": "string",
                  "description": "JSON file that must exist and be non-empty, e.g. the DOM measurement taken at capture time"
                },
                "empty": {
                  "type": "boolean",
                  "description": "A placeholder for a column with nothing to show (e.g. the prototype has no equivalent); needs a caption, no src or crop"
                }
              }
            }
          }
        }
      }
    }
  }
}
