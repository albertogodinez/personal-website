{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-factory/schemas/second-opinion-models.schema.json",
  "title": "Second-opinion reviewer models",
  "description": "The model each CLI runs when toolkit-second-opinion asks it for a review. check-models.mjs compares each pin against the CLI's catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verified",
    "reviewers",
    "reviewTimeoutSeconds",
    "claudeMaxBudgetUsd",
    "cacheMaxAgeDays"
  ],
  "properties": {
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date a person last confirmed the pins against the catalogs."
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "$ref": "#/definitions/reviewer"
        },
        "claude": {
          "$ref": "#/definitions/reviewer"
        }
      }
    },
    "reviewTimeoutSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "claudeMaxBudgetUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cacheMaxAgeDays": {
      "type": "integer",
      "minimum": 1,
      "description": "An offline check skips a catalog cache older than this."
    }
  },
  "definitions": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort",
        "track"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Exact model id passed to the CLI's --model flag."
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "track": {
          "type": "string",
          "minLength": 1,
          "description": "Regex for the model family this pin follows. Group 1 is the version; the newest catalog id it matches is 'latest'."
        }
      }
    }
  }
}
