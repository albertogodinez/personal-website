{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skeleton/card geometry",
  "description": "Geometry measured from a design authority or implementation and read by toolkit-design-verify/scripts/compare-geometry.mjs. Box offsets are CSS px relative to their card.",
  "type": "object",
  "required": ["meta", "cards"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["url", "captured_at"],
      "properties": {
        "url": { "type": "string" },
        "state": { "type": "string" },
        "viewport": { "type": "object" },
        "captured_at": { "type": "string" }
      }
    },
    "cards": {
      "type": "object",
      "description": "One key per --card selector, each a list of the cards it matched",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["card", "boxes"],
          "properties": {
            "card": {
              "type": "object",
              "required": ["w", "h"],
              "properties": {
                "w": { "type": "number", "minimum": 0 },
                "h": { "type": "number", "minimum": 0 },
                "radius": { "type": "string" },
                "bg": { "type": "string" },
                "border": { "type": "string" },
                "shadow": { "type": "string" },
                "padding": { "type": "string" }
              }
            },
            "boxes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "w", "h"],
                "properties": {
                  "cls": { "type": "string" },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "w": { "type": "number", "minimum": 0 },
                  "h": { "type": "number", "minimum": 0 },
                  "radius": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
