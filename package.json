{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "typecheck": "astro check",
    "lint": "oxlint && biome lint .",
    "lint:fix": "oxlint --fix && biome lint --write .",
    "lint:astro": "biome lint . --config-path=./biome.astro.jsonc",
    "preview": "node ./src/scripts/verify-site.ts serve",
    "verify:site": "node ./src/scripts/verify-site.ts",
    "astro": "astro",
    "scaffold:raindrop": "node ./src/scripts/scaffold-raindrop.ts",
    "scaffold:raindrop:dry": "node ./src/scripts/scaffold-raindrop.ts --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/netlify": "^7.0.6",
    "@astrojs/react": "^5.0.3",
    "@astrojs/ts-plugin": "^1.10.7",
    "@cloudinary/url-gen": "^1.22.0",
    "@fontsource/abril-fatface": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@nanostores/react": "^1.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^6.1.6",
    "dotenv": "^17.3.1",
    "nanostores": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "three": "0.182.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.182.0",
    "husky": "^9.1.7",
    "oxlint": "1.90.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
